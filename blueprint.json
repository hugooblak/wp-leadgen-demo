{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Northpine: lead generation WordPress site with CRO basics",
		"description": "Block theme, multi-step quote form with lead inbox, and content migrated from an old site, for a fictional roofing company.",
		"author": "hugooblak",
		"categories": [ "Themes" ]
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": { "resource": "git:directory", "url": "https://github.com/hugooblak/wp-leadgen-demo", "ref": "main", "refType": "branch", "path": "theme/northpine" },
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "git:directory", "url": "https://github.com/hugooblak/wp-leadgen-demo", "ref": "main", "refType": "branch", "path": "plugins/northpine-leads" },
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "git:directory", "url": "https://github.com/hugooblak/wp-leadgen-demo", "ref": "main", "refType": "branch", "path": "plugins/northpine-demo-notes" },
			"options": { "activate": true }
		},
		{ "step": "mkdir", "path": "/wordpress/wp-content/northpine-setup/legacy-export" },
		{ "step": "writeFile", "path": "/wordpress/wp-content/northpine-setup/setup.php", "data": { "resource": "url", "url": "https://raw.githubusercontent.com/hugooblak/wp-leadgen-demo/main/content/setup.php" } },
		{ "step": "writeFile", "path": "/wordpress/wp-content/northpine-setup/migrate.php", "data": { "resource": "url", "url": "https://raw.githubusercontent.com/hugooblak/wp-leadgen-demo/main/content/migrate.php" } },
		{ "step": "writeFile", "path": "/wordpress/wp-content/northpine-setup/legacy-export/how-long-does-a-roof-last.html", "data": { "resource": "url", "url": "https://raw.githubusercontent.com/hugooblak/wp-leadgen-demo/main/content/legacy-export/how-long-does-a-roof-last.html" } },
		{ "step": "writeFile", "path": "/wordpress/wp-content/northpine-setup/legacy-export/repair-or-replace.html", "data": { "resource": "url", "url": "https://raw.githubusercontent.com/hugooblak/wp-leadgen-demo/main/content/legacy-export/repair-or-replace.html" } },
		{ "step": "writeFile", "path": "/wordpress/wp-content/northpine-setup/legacy-export/after-a-hail-storm.html", "data": { "resource": "url", "url": "https://raw.githubusercontent.com/hugooblak/wp-leadgen-demo/main/content/legacy-export/after-a-hail-storm.html" } },
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/northpine-setup/setup.php';"
		}
	]
}
